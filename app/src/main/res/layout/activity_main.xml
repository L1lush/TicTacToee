<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/game_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/game_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/game_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/blue_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_toolbar" />

    <TextView
        android:id="@+id/game_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_mode" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/board_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/board_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/button_new_game"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_status"
        app:strokeWidth="0dp">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:columnCount="3"
            android:rowCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button00"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="0,0"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button01"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="0,1"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button02"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="0,2"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button10"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="1,0"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button11"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="1,1"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button12"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="1,2"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button20"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="2,0"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button21"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="2,1"
                android:textSize="40sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button22"
                style="@style/GameCellButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_margin="4dp"
                android:onClick="onCellClick"
                android:tag="2,2"
                android:textSize="40sp" />
        </GridLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_new_game"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/new_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
