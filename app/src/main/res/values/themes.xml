<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TicTacToe" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/orange_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
    </style>

    <style name="GameCellButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="backgroundTint">@color/cell_empty</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TicTacToe.Cell</item>
    </style>

    <style name="ShapeAppearance.TicTacToe.Cell" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Theme.TicTacToe" parent="Base.Theme.TicTacToe" />
</resources>
